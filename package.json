{
  "name": "@neutrino/website",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "neutrino": "./scripts/new-post.js"
  },
  "scripts": {
    "css:build": "node scripts/build.js",
    "css:watch": "node scripts/watch.js",
    "dev": "eleventy --serve",
    "build:images": "rimraf .cache .img && ELEVENTY_IMAGE_MODE=async eleventy",
    "build": "ELEVENTY_IMAGE_MODE=sync eleventy",
    "rebuild": "npm run build:images && npm run build",
    "serve": "concurrently \"npm run css:watch\" \"npx @11ty/eleventy --serve\"",
    "gen:scss-snippets": "node scripts/gen-scss-snippets.cjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@neutrino/core": "https://github.com/neutrino-cms/neutrino-core#main",
    "concurrently": "^9.2.1",
    "minisearch": "^7.2.0",
    "sass": "^1.93.3"
  },
  "devDependencies": {
    "rimraf": "^5.0.10"
  }
}
