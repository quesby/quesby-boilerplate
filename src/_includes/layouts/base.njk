<!doctype html>
<html lang="en" class="{{ site.defaultVisualTheme }}">
<head>
  <meta charset="utf-8">

  <!-- Viewport per responsive -->
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Titolo dinamico -->
  <title>{{ postTitle or title }}</title>

  <!-- SEO base -->
  <meta name="description" content="{{ postDescription or description | safe }}">

  <!-- Open Graph / Social sharing -->
  <meta property="og:title" content="{{ postTitle or title }}">
  <meta property="og:description" content="{{ postDescription or description | safe }}">
  <meta property="og:type" content="{{ postType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ postImage or site.url }}/assets/og-image.jpg">
  

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ postTitle or title }}">
  <meta name="twitter:description" content="{{ postDescription or description | safe }}">
  <meta name="twitter:image" content="{{ postImage or site.url }}/assets/og-image.jpg">

  <!-- Favicon e manifest -->
  <link rel="icon" href="{{ site.favicon }}" type="image/x-icon">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  {# <link rel="manifest" href="/manifest.json"> #}

  <!-- Theme toggle -->
  <script>
    (function(){
      var ls = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var root = document.documentElement;
      if (ls === 'dark' || (!ls && prefersDark)) root.classList.add('dark');
      else if (ls === 'sepia') root.classList.add('sepia');
    })();
  </script>

  <!-- CSS -->
  <link rel="stylesheet" href="/assets/css/skin.css">
  <link rel="stylesheet" href="/assets/css/expressive-code.css">
</head>
<body class="{{ postClass or class }}">
  {% include "partials/header.njk" %}
  <div class="layout-wrapper">
    <main>
      {% block content %}
        {% if toc %}
          <div class="content-wrapper">
            <div class="content">
              {{ content | safe }}
            </div>
            <aside>
              {% set tocContent = content %}
              {% include "partials/" + toc %}
            </aside>
          </div>
        {% else %}
          {{ content | safe }}
        {% endif %}
      {% endblock %}
    </main>
    {% if aside %}
      <aside>{% include "partials/" + aside %}</aside>
    {% endif %}
  </div>
  {% include "partials/footer.njk" %}
</body>
</html>