{% extends "layouts/base.njk" %}
{% set postTitle = "Neutrino Boilerplate | " + title %}
{% set postClass = "single-post" %}
{% set postType = "article" %}

{% block content %}
<div class="single-post container">
    <article class="post">
        <div class="post__featured-image">
            {% if image %}
                {% image "/content/media/posts/" + image, title, "600", { "loading": "lazy" } %}
            {% endif %}
        </div>
        <div class="post__header boxed">
            <div class="post__date">{{ date | date("dd LLLL yyyy", site.language) }}</div>
            <h1 class="post__title">{{ title }}</h1>
            <p class="post__excerpt">{{ description }}</p>
        </div>
        <div class="boxed">{{ content | safe }}</div>
        <footer></footer>
    </article>
</div>
{% endblock %}