{# 
  SEO partial - Thin wrapper around @quesby/core
  Maintained only for backward compatibility.
  New templates should call the SEO filters directly from layout/base.njk.
#}

{# Build SEO model using full Nunjucks context (this) #}
{%- set seoModel = page | seoModel(site, this) -%}

{# Output meta tags and Open Graph/Twitter tags #}
{{ seoModel | seoHeadHtml(site) | safe }}

{# Output JSON-LD structured data #}
{{ seoModel | seoJsonLd(site) | safe }}
