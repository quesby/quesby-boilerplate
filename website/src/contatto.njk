<div class="v-spacer"></div>
<div class="v-spacer"></div>
<div class="v-spacer"></div>
<section>
    <div class="boxed">
        <h1>Contatto</h1>
        <p>Potete contattarmi tramite i seguenti canali:</p>
        <ul>
            <li>Email: <a href="mailto:theoddapeitalia@gmail.com">theoddapeitalia@gmail.com</a></li>
            <li>Discord: <a href="https://discord.gg/theoddapeitalia" target="_blank" rel="noopener noreferrer nofollow">TheOddApe Italia</a></li>
        </ul>
        <p>Oppure utilizzate il form sottostante:</p>
        
        <form action="https://formsubmit.co/theoddapeitalia@gmail.com" method="POST" />
            <div class="form-group">
                <label class="form-label required" for="name">Nome completo</label>
                <input 
                    type="text" 
                    id="name"
                    name="name" 
                    class="form-input" 
                    placeholder="Inserisci il tuo nome completo"
                    required
                >
            </div>
            
            <div class="form-group">
                <label class="form-label required" for="email">Indirizzo email</label>
                <input 
                    type="email" 
                    id="email"
                    name="email" 
                    class="form-input" 
                    placeholder="esempio@email.com"
                    required
                >
            </div>
            
            <div class="form-group">
                <label class="form-label" for="subject">Oggetto (opzionale)</label>
                <input 
                    type="text" 
                    id="subject"
                    name="subject" 
                    class="form-input" 
                    placeholder="Argomento del messaggio"
                >
            </div>
            
            <div class="form-group">
                <label class="form-label required" for="message">Messaggio</label>
                <textarea 
                    id="message"
                    name="message" 
                    class="form-textarea" 
                    placeholder="Scrivi il tuo messaggio qui..."
                    rows="6"
                    required
                ></textarea>
            </div>
            
            <div class="form-group">
                <button type="submit" class="form-button primary">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22,2 15,22 11,13 2,9"></polygon>
                    </svg>
                    Invia Messaggio
                </button>
            </div>
        </form>
    </div>
</section>