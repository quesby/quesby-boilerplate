{#-
  Hero Section con Slider Dinamico per gli ultimi articoli del blog
  Utilizzo: {% include "hero-slider.njk" %}
  
  Parametri opzionali:
  - posts_limit: numero di post da mostrare (default: 5)
  - show_indicators: mostra indicatori delle slide (default: true)
  - show_arrows: mostra frecce di navigazione (default: true)
  - autoplay: autoplay dello slider (default: true)
  - autoplay_speed: velocità autoplay in ms (default: 5000)
  - aspect_ratio: aspect ratio dello slider (default: "16/9", esempi: "3/2", "4/3", "21/9", "1/1")
-#}

{% set posts_limit = posts_limit or 5 %}
{% set show_indicators = show_indicators or true %}
{% set show_arrows = show_arrows or true %}
{% set autoplay = autoplay or true %}
{% set autoplay_speed = autoplay_speed or 5000 %}
{% set aspect_ratio = aspect_ratio or "16/9" %}

{# Sort posts by date (newest first) and limit to posts_limit #}
{% set latest_posts = collections.posts | sortBy("date", "desc") | limit(posts_limit) %}

{% if latest_posts.length > 0 %}
<section class="hero-slider" data-autoplay="{{ autoplay }}" data-autoplay-speed="{{ autoplay_speed }}" data-aspect-ratio="{{ aspect_ratio }}">
    <div class="hero-slider__counter">
        <span class="current-slide">01</span>/<span class="total-slides">0{{ latest_posts.length }}</span>
    </div>
    <div class="hero-slider__container">
        <div class="hero-slider__wrapper">
            {% for post in latest_posts %}
            <div class="hero-slider__slide" data-slide="{{ loop.index0 }}">
                <div class="hero-slider__background">
                    {% if post.data.image %}
                        {% image "assets/images/blog/{{ post.data.image }}", "{{ post.data.title }}", "600", { loading: "lazy", class: "hero-slider__image" } %}
                        <img src="assets/images/blog/{{ post.data.image }}" alt="{{ post.data.title }}" class="hero-slider__image" loading="lazy">
                    {% else %}
                    <div class="hero-slider__placeholder">
                        <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <polyline points="21,15 16,10 5,21"></polyline>
                        </svg>
                    </div>
                    {% endif %}
                    <div class="hero-slider__overlay"></div>
                </div>
                
                <div class="hero-slider__content">
                    <div class="hero-slider__content-inner">
                        <div class="hero-slider__meta">
                            <span class="hero-slider__category">{{ post.data.type or "Blog" }}</span>
                            <span class="hero-slider__date">{{ post.data.date | date("dd LLLL yyyy") }}</span>
                        </div>
                        
                        <h2 class="hero-slider__title">
                            <a href="{{ post.url }}" class="hero-slider__title-link">
                                {{ post.data.title }}
                            </a>
                        </h2>
                        
                        {% if post.data.description %}
                        <p class="hero-slider__excerpt">{{ post.data.description }}</p>
                        {% endif %}
                        
                        <div class="hero-slider__actions">
                            <a href="{{ post.url }}" class="hero-slider__button">
                                <span>Leggi Articolo</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        
        <div id="buttons">
            {% if show_indicators and latest_posts.length > 1 %}
                <div class="hero-slider__indicators">
                    {% for post in latest_posts %}
                    <button 
                        class="hero-slider__indicator{% if loop.first %} active{% endif %}" 
                        data-slide="{{ loop.index0 }}"
                        aria-label="Vai alla slide {{ loop.index }}"
                    >
                        <span class="hero-slider__indicator-dot"></span>
                    </button>
                    {% endfor %}
                </div>
                {% endif %}
                
                {% if show_arrows and latest_posts.length > 1 %}
                <button class="hero-slider__arrow hero-slider__arrow--prev" aria-label="Slide precedente">
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="39" height="50" viewBox="0 0 39 50" xml:space="preserve">		<path d="M38.9 50 0 25.1 38.9.3V50zm-24-24.9L31 35.4V14.9L14.9 25.1z"></path>	</svg>
                </button>
                <button class="hero-slider__arrow hero-slider__arrow--next" aria-label="Slide successiva">
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="39" height="50" viewBox="0 0 39 50" xml:space="preserve">		<path d="M38.9 50 0 25.1 38.9.3V50zm-24-24.9L31 35.4V14.9L14.9 25.1z"></path>	</svg>
                </button>
                {% endif %}
        </div>

    </div>
    
    <div class="hero-slider__progress">
        <div class="hero-slider__progress-bar"></div>
    </div>
</section>

<!-- JavaScript esterno per evitare problemi di CSP -->
<script src="/assets/js/hero-slider.js"></script>
{% endif %}