{
    "name": "@neutrino/website",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
      "css:build": "node scripts/build.js",
      "css:watch": "node scripts/watch.js",
      "dev": "eleventy --serve",
      "build": "npm run css:build && eleventy",
      "serve": "concurrently \"npm run css:watch\" \"npx @11ty/eleventy --serve\"",
      "extract:mods": "node scripts/extractMods.js",
      "update:installed": "node scripts/updateInstalledMods.js",
      "update:mods": "node --no-deprecation updateMods.js",
      "update:mods:full": "npm run extract:mods && npm run update:installed && npm run update:mods"
    },
    "dependencies": {
      "@neutrino/core": "workspace:*",
      "@11ty/eleventy": "^3.0.0",
      "sass": "^1.77.0",
      "concurrently": "^9.2.1",
      "minisearch": "^7.0.0"
    }
  }
  
